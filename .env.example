# ============================================================
# Voice Agent MVP — Variables de entorno
# Copia este archivo a .env y llena los valores reales.
# ============================================================

# Twilio (llamadas de voz + Media Streams)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Deepgram (Speech-to-Text streaming Y Text-to-Speech con Aura)
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-estrella-es

# Anthropic (cerebro conversacional — Claude Haiku 4.5)
ANTHROPIC_API_KEY=

# Supabase (base de datos PostgreSQL)
# SUPABASE_KEY debe ser la "service_role" key (Project Settings -> API),
# NO la "anon" key -- con anon, Row Level Security bloquea los inserts que
# hace el propio backend.
SUPABASE_URL=
SUPABASE_KEY=

# Dashboard (login del equipo de cada restaurante)
# Los usuarios (correo + contrasena, uno o varios por restaurante) se crean
# con `python admin.py nuevo-usuario ...` -- ya no hay contrasena compartida.
# SESSION_SECRET_KEY: cadena aleatoria larga y fija (ej. `python -c "import
#   secrets; print(secrets.token_hex(32))"`) -- si cambia, se cierran todas
#   las sesiones activas. NO la reutilices de otro proyecto.
SESSION_SECRET_KEY=

# Servidor
HOST=0.0.0.0
PORT=8000
