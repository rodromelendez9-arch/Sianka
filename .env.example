# ============================================================
# Voice Agent MVP — Variables de entorno
# Copia este archivo a .env y llena los valores reales.
# ============================================================

# Twilio (llamadas de voz + Media Streams)
# TWILIO_ACCOUNT_SID: necesario para pasar llamadas a una persona del
# restaurante; sin el, el agente no ofrece transferir.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Deepgram (Speech-to-Text streaming Y Text-to-Speech con Aura)
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-estrella-es

# Anthropic (cerebro conversacional — Claude Haiku 4.5)
ANTHROPIC_API_KEY=

# Supabase (base de datos PostgreSQL)
# SUPABASE_KEY debe ser la "service_role" key (Project Settings -> API),
# NO la "anon" key -- con anon, Row Level Security bloquea los inserts que
# hace el propio backend.
SUPABASE_URL=
SUPABASE_KEY=

# Dashboard (login del equipo de cada restaurante)
# Los usuarios (correo + contrasena, uno o varios por restaurante) se crean
# con `python admin.py nuevo-usuario ...` -- ya no hay contrasena compartida.
# SESSION_SECRET_KEY: cadena aleatoria larga y fija (ej. `python -c "import
#   secrets; print(secrets.token_hex(32))"`) -- si cambia, se cierran todas
#   las sesiones activas. NO la reutilices de otro proyecto.
SESSION_SECRET_KEY=

# ------------------------------------------------------------
# Proteccion de datos personales
# ------------------------------------------------------------
# DATA_ENCRYPTION_KEY: cifra telefonos, nombres y transcripciones (AES-256-GCM).
#   Generala con `python admin.py generar-clave`. SIN ELLA EL SERVIDOR NO
#   ARRANCA. Respaldala fuera del servidor: si se pierde, los datos cifrados
#   son irrecuperables. No la cambies una vez que haya datos cifrados.
DATA_ENCRYPTION_KEY=
# Dias que se conservan las transcripciones antes de borrarse solas.
RETENCION_TRANSCRIPCIONES_DIAS=90
# true = pedir a Deepgram que no use el audio para entrenar sus modelos
# (puede tener impacto en precio: https://dpgr.am/deepgram-mip).
DEEPGRAM_MIP_OPT_OUT=true

# ------------------------------------------------------------
# Sitio publico y avisos legales (/privacidad, /terminos)
# ------------------------------------------------------------
# URL publica (sin diagonal final): canonical, sitemap y el aviso que dice
# el agente por telefono ("...el aviso de privacidad esta en sianka punto m x").
PUBLIC_BASE_URL=https://sianka.mx
# Identidad de Sianka como responsable/encargado. Mientras falte alguno, las
# paginas legales muestran un aviso de "datos pendientes".
SIANKA_RAZON_SOCIAL=
SIANKA_DOMICILIO=
SIANKA_EMAIL_PRIVACIDAD=

# ------------------------------------------------------------
# Pagina de venta (/): botones de contacto. Opcionales, pero sin al menos
# uno la pagina no tiene a donde mandar a un prospecto.
# ------------------------------------------------------------
# WhatsApp con codigo de pais, solo digitos (ej. 5219991234567)
SIANKA_WHATSAPP=
SIANKA_EMAIL_CONTACTO=
# Numero al que un prospecto puede llamar para probar el agente
SIANKA_TELEFONO_DEMO=

# ------------------------------------------------------------
# Costo estimado por llamada (USD). Opcionales: ajustalas cuando cambie
# algun plan. Se consultan con `python admin.py uso`.
# ------------------------------------------------------------
# COSTO_TELEFONIA_MIN=0.015
# COSTO_TRANSCRIPCION_MIN=0.0077
# COSTO_VOZ_1K_CARACTERES=0.030
# COSTO_MODELO_1M_ENTRADA=1.00
# COSTO_MODELO_1M_SALIDA=5.00

# Logs: en Railway salen como JSON solos. LOG_FORMAT=json lo fuerza.
# LOG_LEVEL=INFO

# Servidor (en Railway no los pongas: asigna el puerto solo)
HOST=0.0.0.0
PORT=8000
